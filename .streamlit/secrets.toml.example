# Copy to .streamlit/secrets.toml for local sign-in testing (that file is
# gitignored), or paste into the deployed app's Settings -> Secrets on Streamlit
# Community Cloud. Placeholders only - never commit real values.
# See docs/DEPLOY.md, "Sign-in".

[auth]
# the app's URL + /oauth2callback (locally: http://localhost:8501/oauth2callback)
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# random, 32+ bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-STRING"

[auth.google]
client_id = "REPLACE.apps.googleusercontent.com"
client_secret = "REPLACE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
# who may use the app: exact addresses and/or whole company domains
allowed_emails = ["someone@example.com"]
allowed_domains = ["sebbeninternational.com.br"]

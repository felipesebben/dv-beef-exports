# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# uv
.uv-cache/

# Testing / coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/secrets.toml

# Data
# Raw pulls are regenerable scratch — not committed.
data/raw/*
!data/raw/.gitkeep
# The DuckDB file IS committed (see docs/decisions/0003) — small, narrow
# NCM scope, doubles as our change history via git. Ignore everything
# else generated into data/processed/.
data/processed/*
!data/processed/.gitkeep
!data/processed/*.duckdb
# Reference-only sample data (bulk CSVs, dimension tables) used to design
# raw/staging/marts against real shapes — not part of the pipeline itself
# (see docs/decisions/0002, API-first over bulk CSVs), no need to commit.
data/samples/*/*
!data/samples/*/.gitkeep

# Environment / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
